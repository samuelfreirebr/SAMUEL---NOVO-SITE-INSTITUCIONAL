# Cloudflare Pages lê este arquivo.
# Os index.html apontam para a versão dos assets (?v=) — se ficarem em
# cache, servem CSS velho e o layout quebra.
/*.html
  Cache-Control: no-cache, must-revalidate
/
  Cache-Control: no-cache, must-revalidate
/global
  Cache-Control: no-cache, must-revalidate

# Assets mudam de URL a cada alteração (?v=): cache longo é seguro.
/styles/*
  Cache-Control: public, max-age=31536000, immutable
/js/*
  Cache-Control: public, max-age=31536000, immutable
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/img/*
  Cache-Control: public, max-age=31536000, immutable
